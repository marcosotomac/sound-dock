{
  "manifest_version": 2,
  "name": "Mezcla: Per-Tab Volume",
  "short_name": "Mezcla",
  "version": "1.0.1",
  "description": "Lets Mezcla set the volume of each Safari tab separately.",
  "permissions": ["nativeMessaging", "tabs", "<all_urls>"],
  "background": { "scripts": ["background-safari.js"], "persistent": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject-page-volume.js", "page-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": ["page-volume.js"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
